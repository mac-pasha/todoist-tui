{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC task graph",
  "type": "object",
  "required": ["epic", "title", "tasks"],
  "additionalProperties": false,
  "properties": {
    "epic": { "type": "string", "pattern": "^EPIC-[0-9]{2,}$" },
    "title": { "type": "string", "minLength": 3 },
    "source": { "type": "string", "description": "path to epics.md" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "deps", "files", "acceptance", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 5 },
          "type": { "enum": ["code", "design", "test-int", "test-e2e", "docs"] },
          "stack": { "type": "string", "description": "e.g. laravel, flutter, html" },
          "deps": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "context": { "type": "string" },
          "estimate_h": { "type": "number" },
          "assignee": { "type": "string" },
          "status": { "enum": ["todo", "in_progress", "review", "done", "blocked"] },
          "blocked_reason": { "type": "string" }
        }
      }
    }
  }
}
